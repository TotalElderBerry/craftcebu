# Browser-safe values (Vite exposes anything prefixed VITE_ to the app)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only values. Never prefix these with VITE_.
# Used by scripts/promote-owner.mjs
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Used later by the Maya Edge Functions (set them as Supabase secrets too)
MAYA_PUBLIC_KEY=
MAYA_SECRET_KEY=
